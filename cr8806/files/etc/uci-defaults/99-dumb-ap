#!/bin/sh
# Dumb AP: cong WAN gia nhap br-lan, xoa interface wan/wan6.
# IP quan tri: 192.168.2.1/24 (doi trong LuCI: Network > Interfaces > lan).

# Chi chay 1 lan: sysupgrade giu config thi khong ghi de cau hinh cua ban.
[ "$(uci -q get system.@system[0].dumb_ap)" = "1" ] && exit 0

brdev=""
check_dev() { [ "$(uci -q get network.$1.name)" = "br-lan" ] && brdev="$1"; }
. /lib/functions.sh
config_load network
config_foreach check_dev device

if [ -n "$brdev" ]; then
	uci -q del_list network.$brdev.ports='wan'
	uci add_list network.$brdev.ports='wan'
fi
uci set network.lan.ipaddr='192.168.2.1'
uci set network.lan.netmask='255.255.255.0'
uci -q delete network.wan
uci -q delete network.wan6
uci set system.@system[0].hostname='CR8806-AP'
uci set system.@system[0].dumb_ap='1'
uci commit network
uci commit system
exit 0
