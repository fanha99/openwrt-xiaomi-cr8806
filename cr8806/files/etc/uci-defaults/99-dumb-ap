#!/bin/sh
# Dumb AP: cong WAN gia nhap br-lan, xoa interface wan/wan6.
# IP quan tri van la 192.168.1.1 (doi trong LuCI: Network > Interfaces > lan).

brdev=""
check_dev() { [ "$(uci -q get network.$1.name)" = "br-lan" ] && brdev="$1"; }
. /lib/functions.sh
config_load network
config_foreach check_dev device

if [ -n "$brdev" ]; then
	uci -q del_list network.$brdev.ports='wan'
	uci add_list network.$brdev.ports='wan'
fi
uci -q delete network.wan
uci -q delete network.wan6
uci set system.@system[0].hostname='CR8806-AP'
uci commit network
uci commit system
exit 0
