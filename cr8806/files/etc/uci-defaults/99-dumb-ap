#!/bin/sh
# Router toi thieu, dung lam AP cung duoc:
# - lan (br-lan: lan1-3): 192.168.2.1/24, dnsmasq cap DHCP .150-.199
#   (doi trong LuCI: Network > Interfaces > lan).
# - wan (br-wan: cong wan): DHCP client (doi sang PPPoE trong LuCI neu can),
#   firewall4 + NAT nhu router OpenWrt binh thuong.
# - Lam AP: cam wan vao router chinh, gan SSID vao network "wan" trong LuCI.

# Chi chay 1 lan: sysupgrade giu config thi khong ghi de cau hinh cua ban.
[ -n "$(uci -q get system.@system[0].dumb_ap)" ] && exit 0

. /lib/functions.sh

brdev=""
wandev=""
check_dev() {
	case "$(uci -q get network.$1.name)" in
	br-lan) brdev="$1" ;;
	br-wan) wandev="$1" ;;
	esac
}
config_load network
config_foreach check_dev device

[ -n "$brdev" ] && uci -q del_list network.$brdev.ports='wan'
if [ -z "$wandev" ]; then
	wandev=$(uci add network device)
	uci set network.$wandev.name='br-wan'
	uci set network.$wandev.type='bridge'
fi
uci -q del_list network.$wandev.ports='wan'
uci add_list network.$wandev.ports='wan'

uci set network.lan.ipaddr='192.168.2.1'
uci set network.lan.netmask='255.255.255.0'
uci set network.wan=interface
uci set network.wan.device='br-wan'
uci set network.wan.proto='dhcp'
uci set network.wan6=interface
uci set network.wan6.device='@wan'
uci set network.wan6.proto='dhcpv6'

uci -q get dhcp.lan >/dev/null || uci set dhcp.lan=dhcp
uci set dhcp.lan.interface='lan'
uci set dhcp.lan.start='150'
uci set dhcp.lan.limit='50'
uci set dhcp.lan.leasetime='12h'
uci -q get dhcp.wan >/dev/null || uci set dhcp.wan=dhcp
uci set dhcp.wan.interface='wan'
uci set dhcp.wan.ignore='1'

# Software flow offload: NAT nhanh hon tren CPU (IPQ5000 khong co NSS upstream)
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set irqbalance.irqbalance.enabled='1'

uci set system.@system[0].hostname='CR8806-AP'
uci set system.@system[0].dumb_ap='3'
uci commit network
uci commit dhcp
uci commit firewall
uci commit irqbalance
uci commit system
exit 0
